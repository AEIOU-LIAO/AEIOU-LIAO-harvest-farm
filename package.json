{
  "name": "harvest-farm",
  "version": "3.8.0",
  "private": true,
  "description": "丰收农场：真实多人联网的网页农场偷菜游戏（零依赖：Node 22 + 内置 SQLite）",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "FARM_TEST_CLOCK=1 DB_PATH=data/dev.db node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "node src/build.js && node deploy/bundle-functions.js",
    "build:edgeone": "node deploy/edgeone-dist.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/api.test.js test/edgeone.test.js test/content.test.js",
    "test:turso": "TEST_TURSO=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/api.test.js",
    "check-build": "npm run build && git diff --exit-code index.html cloud-functions shared/content.js",
    "content": "node tools/build-content.js",
    "backup": "node --disable-warning=ExperimentalWarning server/cli.js backup",
    "admin": "node --disable-warning=ExperimentalWarning server/cli.js"
  }
}
