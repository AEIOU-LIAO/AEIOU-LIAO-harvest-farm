// 家园布局：3D 画面（src/world3d.js）和服务器（建造网格占用、摆放校验）读同一份数据。
// 坐标单位：米；x 向右、z 向下（屏幕下方 / 房子前方），原点是第 1 片菜地的中心。ry 为朝向（弧度）。
// 改这里会移动游戏里的建筑，也会改变哪些格子能自由建造。
{
  // 建造网格：覆盖整个家园（含 20 片菜地、扩建满级的牧场、6 个池塘、果园）
  "grid": { "cell": 2, "x0": -70, "x1": 60, "z0": -92, "z1": 40 },

  // 固定建筑：w × d 为占地（米），只用于建造网格，不影响画面
  "structures": [
    { "id": "house", "name": "房子", "x": -13, "z": -2.5, "ry": 0.15, "w": 7, "d": 7, "obstacle": 3.3 },
    { "id": "windmill", "name": "风车", "x": 3.5, "z": -15, "ry": -0.2, "w": 4, "d": 4, "obstacle": 1.9 },
    { "id": "doghouse", "name": "狗窝", "x": 11.2, "z": -3.8, "ry": -0.6, "w": 2, "d": 2, "obstacle": 0.9 },
    { "id": "scarecrow", "name": "稻草人", "x": -10.5, "z": 6.5, "ry": 0, "w": 1, "d": 1, "obstacle": 0.35 }
  ],

  // 菜地：第 1 片在原点，之后每排 cols 片，横向间隔 dx、纵向从 z0 开始每排间隔 dz；每片占地 w × d
  "fields": { "cols": 4, "dx": 17, "z0": -32, "dz": 13, "w": 15.2, "d": 11.2 },

  // 池塘：按鱼塘等级逐个开挖（每 perLv 级多一个，最多 6 个）；每个占地 w × d
  "ponds": { "list": [[-5.5, 13.5], [-17.5, 15], [-29, 14], [-6.5, 26], [-18.5, 27.5], [-30, 27]], "perLv": 5, "w": 8.4, "d": 6.8 },

  // 牧场：左上角 (x0, z0) 固定，宽高随牧场等级增长：base + grow × ((等级 - 1) / 99) ^ pow
  "pasture": { "x0": 10.2, "z0": 7.0, "base": [6.4, 5.2], "grow": [34, 24], "pow": 0.6 },

  // 果园：近似圆形区域（中心 + 半径），画面里边界随角度起伏
  "orchard": { "x0": -64, "x1": -36, "z0": -16, "z1": 12, "r": 14.5 }
}
