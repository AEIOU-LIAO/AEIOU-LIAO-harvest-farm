# 复制为 .env 后按需修改（.env 不会提交到 Git）
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# 数据库二选一：
# 1) Turso 云数据库（EdgeOne 部署必须用这个；自己的服务器也可以用）。填写后 DB_PATH 不再生效
#    令牌只放在这里或 EdgeOne 的环境变量里，不要提交到 Git
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 2) 本地 SQLite 文件（自己的服务器，Node 22.13+）；开发 / 测试 / 生产请使用不同的文件
DB_PATH=data/farm.db
# 自动备份：目录、间隔（小时，0 表示关闭）、保留份数
BACKUP_DIR=data/backups
BACKUP_HOURS=24
BACKUP_KEEP=7
# 游戏日期按此时区计算（分钟），默认 UTC+8，不受服务器所在地影响
TZ_OFFSET_MIN=480
# 放在 Nginx 等反向代理后面时设为 1，才能按真实 IP 限流
TRUST_PROXY=1
# 前端单独托管在别的域名（如 EdgeOne）时，填写允许跨域的页面地址，逗号分隔
CORS_ORIGINS=
# 启动时自动设为管理员的账号（需先在游戏里注册/绑定），逗号分隔
ADMIN_USERNAMES=
# NPC 玩家数量（0 关闭，最多 80）。NPC 对玩家来说和真人一样，只有运营后台能区分；不计入运营指标，也不占用真人的赛季奖励名次
NPC_COUNT=24
# 仅开发/测试：允许 /api/test/clock 拨动服务器时钟。生产环境（NODE_ENV=production）下无论如何都不会开启
FARM_TEST_CLOCK=0
